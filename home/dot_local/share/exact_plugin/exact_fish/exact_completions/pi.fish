# UPSTREAM: Pi will not maintain shell completion.
# https://github.com/earendil-works/pi/issues/4776#issuecomment-4493229307
set -l commands install remove uninstall update list config auth mcp
set -l main "not __fish_seen_subcommand_from $commands"

complete --command pi --condition __fish_use_subcommand --arguments 'install remove uninstall update list config auth mcp' --description 'Pi command'
complete --command pi --short-option h --long-option help --description 'Show help'
complete --command pi --short-option a --long-option approve --description 'Trust project configuration for this process'
complete --command pi --old-option na --long-option no-approve --description 'Ignore project configuration for this process'

complete --command pi --condition "$main" --short-option v --long-option version --description 'Show version'
complete --command pi --condition "$main" --short-option p --long-option print --description 'Print response and exit'
complete --command pi --condition "$main" --long-option mode --exclusive --arguments 'text json rpc' --description 'Select output mode'
complete --command pi --condition "$main" --long-option export --require-parameter --description 'Export a session file'
complete --command pi --condition "$main" --long-option provider --exclusive --description 'Select model provider'
complete --command pi --condition "$main" --long-option model --exclusive --description 'Select model by ID or fuzzy match'
complete --command pi --condition "$main" --long-option api-key --exclusive --description 'Override API key without saving'
complete --command pi --condition "$main" --long-option thinking --exclusive --arguments 'off minimal low medium high xhigh max' --description 'Select thinking level'
complete --command pi --condition "$main" --long-option models --exclusive --description 'Comma-separated model scope'
complete --command pi --condition "$main" --long-option list-models --description 'List available models'

complete --command pi --condition "$main" --short-option c --long-option continue --description 'Continue the most recent session'
complete --command pi --condition "$main" --short-option r --long-option resume --description 'Select a saved session to resume'
complete --command pi --condition "$main" --long-option session --require-parameter --description 'Open a session by file path or ID'
complete --command pi --condition "$main" --long-option session-id --exclusive --description 'Open or create a session with this ID'
complete --command pi --condition "$main" --long-option fork --require-parameter --description 'Fork a session by file path or ID'
complete --command pi --condition "$main" --long-option session-dir --require-parameter --arguments '(__fish_complete_directories)' --description 'Override session storage directory'
complete --command pi --condition "$main" --long-option no-session --description 'Do not persist this session'
complete --command pi --condition "$main" --short-option n --long-option name --exclusive --description 'Set the session display name'

complete --command pi --condition "$main" --short-option t --long-option tools --exclusive --description 'Comma-separated tool selection'
complete --command pi --condition "$main" --old-option xt --long-option exclude-tools --exclusive --description 'Comma-separated tools or patterns to disable'
complete --command pi --condition "$main" --old-option nbt --long-option no-builtin-tools --description 'Disable built-in tools'
complete --command pi --condition "$main" --old-option nt --long-option no-tools --description 'Disable all tools'
complete --command pi --condition "$main" --short-option e --long-option extension --require-parameter --description 'Load an extension file or directory'
complete --command pi --condition "$main" --old-option ne --long-option no-extensions --description 'Disable discovered and configured extensions'
complete --command pi --condition "$main" --long-option no-mcp --description 'Disable built-in MCP support'
complete --command pi --condition "$main" --long-option skill --require-parameter --description 'Load a skill file or directory'
complete --command pi --condition "$main" --old-option ns --long-option no-skills --description 'Disable discovered and configured skills'
complete --command pi --condition "$main" --long-option prompt-template --require-parameter --description 'Load a prompt template'
complete --command pi --condition "$main" --old-option np --long-option no-prompt-templates --description 'Disable discovered and configured templates'
complete --command pi --condition "$main" --long-option theme --require-parameter --description 'Load a theme file or directory'
complete --command pi --condition "$main" --long-option use-theme --exclusive --description 'Select the initial theme'
complete --command pi --condition "$main" --long-option no-themes --description 'Disable discovered and configured themes'
complete --command pi --condition "$main" --old-option nc --long-option no-context-files --description 'Disable AGENTS.md and CLAUDE.md discovery'
complete --command pi --condition "$main" --long-option system-prompt --require-parameter --description 'Replace the system prompt with text or a file'
complete --command pi --condition "$main" --long-option append-system-prompt --require-parameter --description 'Append text or a file to the system prompt'
complete --command pi --condition "$main" --long-option tui-mode --exclusive --arguments 'fullscreen regular' --description 'Select terminal UI mode'
complete --command pi --condition "$main" --long-option verbose --description 'Show verbose startup information'
complete --command pi --condition "$main" --long-option offline --description 'Disable automatic network activity'

complete --command pi --condition '__fish_seen_subcommand_from install remove uninstall config' --short-option l --long-option local --description 'Use project settings'
complete --command pi --condition '__fish_seen_subcommand_from update' --long-option extensions --description 'Update installed packages'
complete --command pi --condition '__fish_seen_subcommand_from update' --long-option models --description 'Refresh model catalogs'
complete --command pi --condition '__fish_seen_subcommand_from update' --long-option all --description 'Update Pi and all packages'
complete --command pi --condition '__fish_seen_subcommand_from update' --long-option force --description 'Reinstall Pi'

complete --command pi --condition '__fish_seen_subcommand_from auth; and not __fish_seen_subcommand_from check print-api-key print-bearer-token' --exclusive --arguments 'check print-api-key print-bearer-token' --description 'Credential command'
complete --command pi --condition '__fish_seen_subcommand_from auth' --long-option provider --exclusive --description 'Resolve credentials for this provider'
complete --command pi --condition '__fish_seen_subcommand_from auth' --long-option model --exclusive --description 'Resolve credentials for this model'
complete --command pi --condition '__fish_seen_subcommand_from auth' --long-option no-refresh --description 'Do not refresh expired OAuth credentials'
complete --command pi --condition '__fish_seen_subcommand_from auth; and __fish_seen_subcommand_from check' --long-option json --description 'Output structured status'
complete --command pi --condition '__fish_seen_subcommand_from auth; and __fish_seen_subcommand_from check' --long-option credentials --description 'Include the resolved credential'
complete --command pi --condition '__fish_seen_subcommand_from auth; and __fish_seen_subcommand_from print-bearer-token' --long-option min-expiry --exclusive --description 'Require remaining token lifetime'

complete --command pi --condition '__fish_seen_subcommand_from mcp; and not __fish_seen_subcommand_from add remove list login logout' --exclusive --arguments 'add remove list login logout' --description 'MCP command'
complete --command pi --condition '__fish_seen_subcommand_from mcp; and __fish_seen_subcommand_from add remove login logout' --short-option l --long-option local --description 'Use project MCP settings'
complete --command pi --condition '__fish_seen_subcommand_from mcp; and __fish_seen_subcommand_from list' --long-option json --description 'Output structured server status'
complete --command pi --condition '__fish_seen_subcommand_from mcp; and __fish_seen_subcommand_from login' --long-option timeout --exclusive --description 'Login timeout in seconds'
