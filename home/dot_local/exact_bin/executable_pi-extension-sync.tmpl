#!/usr/bin/env bash
{{ $extensionSource := joinPath .chezmoi.sourceDir "dot_config" "pi" "extensions" "exact_local" }}
{{ $extensionTarget := joinPath .chezmoi.homeDir ".config" "pi" "extensions" "local" }}

set -euo pipefail

source_dir={{ $extensionSource | toJson }}
target_dir={{ $extensionTarget | toJson }}

if [[ ! -d "$source_dir" ]]; then
  printf 'Pi extension source directory does not exist: %s\n' "$source_dir" >&2
  exit 1
fi

mkdir --parents "$target_dir"

exec rsync \
  --archive \
  --delete \
  --exclude '/node_modules/' \
  --exclude '/package.json' \
  --exclude '/package-lock.json' \
  --exclude '/tsconfig.json' \
  --exclude '/tsconfig.base.json' \
  "$source_dir/" \
  "$target_dir/"
