#!/bin/sh

set -eu

if [ "$#" -eq 0 ]; then
  printf 'Usage: firstmate <anchor> [arguments...]\n' >&2
  exit 2
fi
requested=$1
shift
if [ ! -d "$requested" ]; then
  printf 'Cannot run Firstmate: anchor is not a directory: %s\n' "$requested" >&2
  exit 1
fi
if ! FM_ANCHOR=$(CDPATH='' cd -P -- "$requested" 2>/dev/null && pwd -P); then
  printf 'Cannot run Firstmate: anchor cannot be resolved: %s\n' "$requested" >&2
  exit 1
fi
FM_HOME="$FM_ANCHOR/.firstmate/home"
export FM_ANCHOR FM_HOME

exec "${XDG_DATA_HOME:-"$HOME/.local/share"}/firstmate/bin/fm-firstmate.sh" "$@"
