#!/bin/sh
# Personal Pi/tmux/Nono policy; shared core owns local anchoring and its gate.
set -eu

fail() {
  printf 'firstmate: %s\n' "$*" >&2
  exit 1
}

[ "$#" -ge 1 ] || fail 'usage: firstmate ANCHOR [Pi arguments...]'
[ "$(uname -s)" = Linux ] || fail 'local vessels currently require Linux'
anchor=$(CDPATH='' cd -P -- "$1" && pwd -P) || fail 'anchor must be an existing directory'
shift
vessel="$anchor/.firstmate"
root="${XDG_DATA_HOME:-"$HOME/.local/share"}/firstmate"
[ -x "$root/bin/fm-anchor.sh" ] || fail 'install the local-anchoring core first'

if [ -d "$root/.tools/node_modules/.bin" ]; then
  PATH="$root/.tools/node_modules/.bin:$PATH"
fi
export PATH

for tool in pi tmux nono jq; do
  command -v "$tool" >/dev/null || fail "required tool is missing: $tool"
done
pi=$(command -v pi)

export NONO_NO_SAVE_PROMPT="${NONO_NO_SAVE_PROMPT-1}"
export PI_SKIP_VERSION_CHECK="${PI_SKIP_VERSION_CHECK-1}"
export PI_CLIPBOARD_OSC52="${PI_CLIPBOARD_OSC52-1}"
export NO_MISTAKES_NO_UPDATE_CHECK="${NO_MISTAKES_NO_UPDATE_CHECK-1}"
export FM_WORKER_ENV_FORWARD_DEFAULTS="${FM_WORKER_ENV_FORWARD_DEFAULTS:+$FM_WORKER_ENV_FORWARD_DEFAULTS }PI_SKIP_VERSION_CHECK PI_CLIPBOARD_OSC52 NO_MISTAKES_NO_UPDATE_CHECK"

session_path() {
  case "$1" in
  /*) ;;
  *) fail 'Pi sessions require a vessel-contained absolute path, not an unscoped ID' ;;
  esac
  resolved=$(realpath -m -- "$1")
  case "$resolved" in
  "$vessel" | "$vessel"/*) ;;
  *) fail 'Pi session path is outside the vessel' ;;
  esac
}

need_path=''
for argument; do
  if [ -n "$need_path" ]; then
    session_path "$argument"
    need_path=''
    continue
  fi
  case "$argument" in
  --) break ;;
  --session | --session-dir) need_path=$argument ;;
  --session=* | --session-dir=*) session_path "${argument#*=}" ;;
  esac
done
[ -z "$need_path" ] || fail "$need_path requires a path"

if [ ! -e "$anchor/.firstmate.json" ] && [ ! -L "$anchor/.firstmate.json" ]; then
  printf 'Anchor a new vessel here? [y/N] ' >&2
  IFS= read -r answer || exit 1
  case "$answer" in
  y | Y | yes | YES) configuration=$("$root/bin/fm-anchor.sh" init --anchor "$anchor") ;;
  *) exit 1 ;;
  esac
  # This is caller-owned policy; core supplies the selected tool-state location.
  nm_home=$(printf '%s\n' "$configuration" | jq -er '.options.NM_HOME')
  if [ ! -e "$nm_home/config.yaml" ]; then
    printf 'agent: pi\n' >"$nm_home/config.yaml"
  fi
fi

exec "$root/bin/fm-anchor.sh" run --anchor "$anchor" -- \
  nono run \
  --strict-broker-path \
  --profile firstmate \
  --workdir "$root" \
  --read "$root" \
  --allow "$vessel" -- \
  "$pi" --approve "$@"
