#!/bin/sh

set -eu

if [ -z "${XDG_DATA_HOME:-}" ] || [ -z "${XDG_STATE_HOME:-}" ]; then
  printf 'Cannot run FirstMate: XDG_DATA_HOME and XDG_STATE_HOME must be set.\n' >&2
  exit 1
fi

root="$XDG_DATA_HOME/firstmate"
tools="$root/.tools"
requested_root=${1:-$PWD}
if [ "$#" -gt 0 ]; then
  shift
fi
if ! projects=$(cd "$requested_root" 2>/dev/null && pwd -P); then
  printf 'Cannot run FirstMate: root directory not found: %s\n' "$requested_root" >&2
  exit 1
fi
home="$projects/.firstmate"
zellij_home="$home/zellij"

if [ ! -d "$root/.git" ]; then
  printf 'FirstMate checkout not found: %s\n' "$root" >&2
  exit 1
fi

mkdir -p "$home" "$zellij_home/socket"
cd "$root"

export PATH="$tools/node_modules/.bin:$PATH"
export NONO_NO_SAVE_PROMPT=1
export PI_SKIP_VERSION_CHECK=1
export PI_CLIPBOARD_OSC52=1
export FM_HOME="$home"
export LAVISH_AXI_STATE_DIR="${LAVISH_AXI_STATE_DIR:-"$home/lavish-axi"}"
export NM_HOME="${NM_HOME:-"$home/no-mistakes"}"
export NO_MISTAKES_NO_UPDATE_CHECK=1
export ZELLIJ_SOCKET_DIR="${ZELLIJ_SOCKET_DIR:-"$zellij_home/socket"}"
export FM_BACKEND="${FM_BACKEND:-zellij}"
export FM_PROJECTS_OVERRIDE="$projects"
export TREEHOUSE_ROOT="$projects"
export FM_WORKER_ENV_FORWARD='PATH
TREEHOUSE_ROOT
PI_SKIP_VERSION_CHECK
PI_CLIPBOARD_OSC52
LAVISH_AXI_STATE_DIR
NM_HOME
NO_MISTAKES_NO_UPDATE_CHECK'

exec nono run \
  --strict-broker-path \
  --profile firstmate \
  --workdir "$root" \
  --read "$root" \
  --allow "$home" \
  --allow "$projects" \
  -- pi --approve "$@"
