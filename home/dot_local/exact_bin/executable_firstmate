#!/bin/sh
# Personal Pi/tmux/Nono policy; core owns anchoring, discovery and sailing.
set -eu

fail() {
  printf 'firstmate: %s\n' "$*" >&2
  exit 1
}

[ "$#" -ge 1 ] || fail 'usage: firstmate ANCHOR [Pi arguments...]'
[ "$(uname -s)" = Linux ] || fail 'local vessels currently require Linux'
anchor=$(CDPATH='' cd -P -- "$1" && pwd -P) || fail 'anchor must be an existing directory'
shift
vessel="$anchor/.firstmate"
firstmate="${XDG_DATA_HOME:-"$HOME/.local/share"}/firstmate"
[ -x "$firstmate/bin/fm-anchor.sh" ] || fail 'install the local-anchoring core first'

for tool in pi tmux nono; do
  command -v "$tool" >/dev/null || fail "required tool is missing: $tool"
done

if [ -d "$firstmate/.tools/node_modules/.bin" ]; then
  PATH="$firstmate/.tools/node_modules/.bin:$PATH"
fi
export PATH

if [ ! -e "$anchor/.firstmate.json" ] && [ ! -L "$anchor/.firstmate.json" ]; then
  printf 'Sail a vessel here from another harbor? [y/N] ' >&2
  IFS= read -r answer || exit 1
  case "$answer" in
  y | Y | yes | YES)
    printf 'Source harbor (source work must already be stopped): ' >&2
    IFS= read -r source_harbor || exit 1
    [ -n "$source_harbor" ] || fail 'a source harbor is required'
    "$firstmate/bin/fm-anchor.sh" sail --anchor "$anchor" --from "$source_harbor" >/dev/null
    ;;
  *)
    printf 'Anchor a new vessel here? [y/N] ' >&2
    IFS= read -r answer || exit 1
    case "$answer" in
    y | Y | yes | YES) "$firstmate/bin/fm-anchor.sh" init --anchor "$anchor" --agent pi >/dev/null ;;
    *) exit 1 ;;
    esac
    ;;
  esac
else
  "$firstmate/bin/fm-anchor.sh" sail --anchor "$anchor" >/dev/null
fi

exec "$firstmate/bin/fm-anchor.sh" run --anchor "$anchor" -- \
  nono run \
  --strict-broker-path \
  --profile firstmate \
  --workdir "$firstmate" \
  --read "$firstmate" \
  --allow "$vessel" -- \
  pi \
  --approve \
  --session-dir "$vessel/pi/primary" \
  --continue \
  --name captain \
  "$@"
