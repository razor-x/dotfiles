#!/usr/bin/env bash
{{ $agentsSource := joinPath .chezmoi.sourceDir "dot_config" "pi" "AGENTS.md" }}
{{ $agentsTarget := joinPath .chezmoi.homeDir ".config" "pi" "AGENTS.md" }}
{{ $extensionSource := joinPath .chezmoi.sourceDir "dot_config" "pi" "extensions" "exact_local" }}
{{ $extensionTarget := joinPath .chezmoi.homeDir ".config" "pi" "extensions" "local" }}

set -euo pipefail

agents_source={{ $agentsSource | toJson }}
agents_target={{ $agentsTarget | toJson }}
source_dir={{ $extensionSource | toJson }}
target_dir={{ $extensionTarget | toJson }}

if [[ "$agents_source" != /* || "$agents_target" != /* ||
      "$source_dir" != /* || "$target_dir" != /* ]]; then
  printf 'Pi dotfile paths must be absolute.\n' >&2
  exit 1
fi

if [[ ! -f "$agents_source" ]]; then
  printf 'Pi AGENTS.md source does not exist: %s\n' "$agents_source" >&2
  exit 1
fi

if [[ ! -d "$source_dir" ]]; then
  printf 'Pi extension source directory does not exist: %s\n' "$source_dir" >&2
  exit 1
fi

if [[ -L "$agents_target" || ( -e "$agents_target" && ! -f "$agents_target" ) ]]; then
  printf 'Refusing to replace non-file Pi AGENTS.md target: %s\n' "$agents_target" >&2
  exit 1
fi

# Never allow a bad template value or a symlink to turn the cleanup below into
# a recursive delete of the source tree or some unrelated directory.
source_real=$(realpath --canonicalize-existing -- "$source_dir")
target_real=$(realpath --canonicalize-missing -- "$target_dir")
if [[ "$source_real" == / || "$target_real" == / ||
      "$source_real" == "$target_real" ||
      "$source_real" == "$target_real/"* ||
      "$target_real" == "$source_real/"* ]]; then
  printf 'Refusing to sync overlapping Pi extension paths:\n  source: %s\n  target: %s\n' \
    "$source_real" "$target_real" >&2
  exit 1
fi

if [[ -L "$target_dir" || ( -e "$target_dir" && ! -d "$target_dir" ) ]]; then
  printf 'Refusing to replace non-directory Pi extension target: %s\n' "$target_dir" >&2
  exit 1
fi

mkdir --parents -- "$(dirname -- "$agents_target")" "$target_dir"
cp --remove-destination --preserve=mode,timestamps -- "$agents_source" "$agents_target"

# Replace only generated TypeScript files. Other files in the target are left
# alone, and node_modules is never copied from the source tree.
find "$target_dir" \
  \( -type f -o -type l \) -name '*.ts' -delete

(
  cd -- "$source_dir"
  find . \
    -type d -name node_modules -prune -o \
    \( -type f -o -type l \) -name '*.ts' \
    -exec cp --archive --parents --target-directory="$target_dir" -- {} +
)
