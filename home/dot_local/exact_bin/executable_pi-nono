#!/bin/sh

set -eu

export NONO_NO_SAVE_PROMPT=1
export PI_SKIP_VERSION_CHECK=1

if git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  exec nono run --strict-broker-path --allow-cwd --allow "$git_common_dir" --profile pi -- pi "$@"
fi

exec nono run --strict-broker-path --allow-cwd --profile pi -- pi "$@"
