# Ignore generated kitty config backup file.
.config/kitty/kitty.conf.bak

# Ignore generated kitty theme files.
{{ range (list "current-theme" "dark-theme.auto" "light-theme.auto" "no-preference-theme.auto") -}}
.config/kitty/{{ . }}.conf
{{ end -}}

# UPSTREAM: Ignore nushell history file until the location respects XDG.
# https://github.com/nushell/nushell/issues/10100
.config/nushell/history.txt

# Ignore symlinked Yazi _package.toml.
# https://www.chezmoi.io/user-guide/manage-different-types-of-file/#handle-configuration-files-which-are-externally-modified
.config/yazi/_package.toml

# Ignore Yazi installed plugins and flavors.
{{ range (list "plugins" "flavors") -}}
.config/yazi/{{ . }}
{{ end -}}

# Ignore private environment variables.
.config/environment.d/99-private.conf
.config/environment.d/99-private-*.conf

{{ if not (has .chezmoi.hostname (list "minto" "anny")) -}}
.config/environment.d/xsecurelock.conf
{{ end -}}

# Ignore Neovim tests.
.config/nvim/tests
.config/nvim/tests/**

# Ignore locally installed Pi packages.
.config/pi/packages
.config/pi/packages/**

# Ignore TypeScript environment for pi extensions.
.config/pi/npm/.gitignore
.config/pi/npm/node_modules
.config/pi/extensions/local/tsconfig.json
.config/pi/extensions/local/tsconfig.*.json
.config/pi/extensions/local/vitest.config.ts
.config/pi/extensions/local/test/
.config/pi/extensions/local/test/**
.config/pi/extensions/local/node_modules
.config/pi/extensions/local/node_modules/**
