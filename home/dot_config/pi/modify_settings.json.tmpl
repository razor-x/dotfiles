#!/usr/bin/env -S fish --no-config

{{ $pkg := include "dot_config/pi/exact_npm/package.json" | fromJson }}
{{ $packages := list }}
{{ range $name := keys $pkg.dependencies | sortAlpha }}
{{ $packages = append $packages (printf "npm:%s@%s" $name (index $pkg.dependencies $name)) }}
{{ end }}
set settings '{{ include "dot_config/pi/_settings.json" | fromJson | toJson | includeTemplate "fish-quote" }}'
set theme '{{ includeTemplate "theme" (merge (dict "app" "pi") .) | includeTemplate "fish-quote" }}'
set packages '{{ $packages | toJson | includeTemplate "fish-quote" }}'

set input (mktemp)

function cleanup --on-event fish_exit
    rm --force "$input"
end

cat >$input

if not test -s $input
    printf '{}\n' >$input
end

jq --argjson settings $settings --arg theme $theme --argjson packages $packages '
  . * $settings * { theme: $theme }
  | .packages = (
    [ .packages[]?
      | select(
          if type == "string"
          then startswith("npm:") | not
          else (.source? // "" | startswith("npm:") | not)
          end
        )
    ] + $packages
  )
' $input
