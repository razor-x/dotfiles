{
  "name": "pi-local-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck",
    "precheck": "npm run test",
    "postcheck": "npm run lint",
    "test": "vitest run",
    "typecheck": "tsc",
    "posttypecheck": "tsc --project tsconfig.test.json",
    "lint": "biome lint",
    "postlint": "biome format",
    "watch": "vitest",
    "format": "biome format --write"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
