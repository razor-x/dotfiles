{
  "name": "pi-local-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck",
    "precheck": "npm run test",
    "postcheck": "npm run lint",
    "test": "vitest run",
    "typecheck": "tsc",
    "posttypecheck": "tsc --project tsconfig.test.json",
    "lint": "biome lint",
    "postlint": "biome format",
    "watch": "vitest",
    "format": "biome format --write"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "22.19.19",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "@earendil-works/pi-agent-core": "1.5.2"
  },
  "allowScripts": {
    "@google/genai": false,
    "esbuild": false,
    "protobufjs": false
  }
}
