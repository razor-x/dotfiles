{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": false,
    "paths": {
      "@/*": ["./src/*"],
      "test/*": ["./test/*"]
    }
  },
  "include": ["test/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "**/*.d.ts"]
}
