{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts", "src/**/*.ts"],
  "exclude": [
    "node_modules",
    "test",
    "**/*.d.ts",
    "**/*.test.ts",
    "vitest.config.ts"
  ]
}
