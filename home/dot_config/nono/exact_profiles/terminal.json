{
  "meta": {
    "name": "terminal",
    "version": "1.0.0",
    "description": "Minimum read-only access to configuration required by general terminal tools.",
    "author": "razor-x"
  },
  "filesystem": {
    "read": [
      "$XDG_CONFIG_HOME/fd",
      "$XDG_CONFIG_HOME/fish",
      "$XDG_CONFIG_HOME/git",
      "$XDG_CONFIG_HOME/ripgrep",
      "$XDG_CONFIG_HOME/tealdeer",
      "$XDG_CONFIG_HOME/worktrunk",
      "$XDG_CONFIG_HOME/zsh",
      "$XDG_DATA_HOME/man",
      "$XDG_DATA_HOME/plugin",
      "$XDG_DATA_HOME/theme"
    ],
    "read_file": ["$HOME/.bash_profile", "$HOME/.bashrc"],
    "bypass_protection": [
      "$HOME/.bash_profile",
      "$HOME/.bashrc",
      "$XDG_CONFIG_HOME/fish"
    ]
  }
}
