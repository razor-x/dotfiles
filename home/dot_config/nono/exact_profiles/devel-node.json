{
  "meta": {
    "name": "devel-node",
    "version": "1.0.0",
    "description": "Node.js, npm, pnpm, and Yarn configuration and caches."
  },
  "filesystem": {
    "read": [
      "$XDG_CONFIG_HOME/npm",
      "$XDG_CACHE_HOME/npm",
      "$XDG_CACHE_HOME/node-gyp",
      "$XDG_CACHE_HOME/pnpm",
      "$XDG_DATA_HOME/node",
      "$XDG_DATA_HOME/pnpn",
      "$XDG_CACHE_HOME/yarn",
      "$XDG_DATA_HOME/yarn"
    ]
  }
}
