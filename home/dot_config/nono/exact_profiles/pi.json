{
  "extends": ["default", "nvim", "terminal"],
  "meta": {
    "name": "pi",
    "version": "1.0.0",
    "description": "Pi Coding Agent. UPSTREAM: Allows /tmp for Pi external editor temp files pending nono TEMPDIR isolation. https://github.com/nolabs-ai/nono/issues/258",
    "author": "razor-x"
  },
  "groups": {
    "include": [
      "node_runtime",
      "rust_runtime",
      "python_runtime",
      { "name": "user_caches_linux", "when": "linux" },
      { "name": "linux_sysfs_read", "when": "linux" },
      "nix_runtime",
      "git_config",
      "unlink_protection"
    ]
  },
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "filesystem": {
    "allow": ["$XDG_CONFIG_HOME/pi", "/tmp"]
  },
  "network": {
    "block": false,
    "allow_domain": [],
    "credentials": [],
    "open_port": [],
    "listen_port": [],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "GITHUB_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "token {}",
        "env_var": "GITHUB_TOKEN"
      }
    }
  },
  "workdir": { "access": "readwrite" },
  "open_urls": {
    "allow_origins": ["https://auth.openai.com", "https://github.com"],
    "allow_localhost": true
  },
  "allow_launch_services": true,
  "undo": {
    "exclude_patterns": [
      "node_modules",
      ".next",
      "__pycache__",
      "target",
      ".pi"
    ],
    "exclude_globs": ["*.tmp.[0-9]*.[0-9]*"]
  },
  "interactive": true
}
