{{- $extensionSource := joinPath .chezmoi.sourceDir "dot_config" "pi" "extensions" "exact_local" -}}
{
  "extends": ["default", "nvim", "terminal", "devel"],
  "meta": {
    "name": "pi",
    "version": "1.0.0",
    "description": "Pi Coding Agent. UPSTREAM: Allows /tmp for Pi external editor temp files pending nono TEMPDIR isolation. https://github.com/nolabs-ai/nono/issues/258",
    "author": "razor-x"
  },
  "groups": {
    "include": [
      { "name": "user_caches_linux", "when": "linux" },
      { "name": "linux_sysfs_read", "when": "linux" },
      "unlink_protection"
    ]
  },
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "filesystem": {
    "allow": [
      "$XDG_CONFIG_HOME/pi",
      "$XDG_CONFIG_HOME/mcp",
      {{ $extensionSource | toJson }},
      "/tmp"
    ],
    "suppress_save_prompt": ["/"]
  },
  "network": {
    "block": false,
    "allow_domain": [],
    "open_port": [],
    "listen_port": []
  },
  "workdir": { "access": "readwrite" },
  "open_urls": {
    "allow_origins": ["https://auth.openai.com", "https://github.com"],
    "allow_localhost": true
  },
  "allow_launch_services": true,
  "undo": {
    "exclude_patterns": [
      "node_modules",
      ".next",
      "__pycache__",
      "target",
      ".pi"
    ],
    "exclude_globs": ["*.tmp.[0-9]*.[0-9]*"]
  },
  "interactive": true
}
