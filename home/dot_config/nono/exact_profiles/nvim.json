{
  "meta": {
    "name": "nvim",
    "version": "1.0.0",
    "description": "Neovim profile for reading config and writing runtime state.",
    "author": "razor-x"
  },
  "filesystem": {
    "allow": [
      "$XDG_DATA_HOME/nvim",
      "$XDG_STATE_HOME/nvim",
      "/tmp/pi-nvim-sockets"
    ],
    "allow_file": ["/tmp/pi-nvim-latest.sock"],
    "read": ["$XDG_CONFIG_HOME/nvim"]
  }
}
